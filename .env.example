# Copy to .env (gitignored). Every value is optional.

# Clerk session JWT for the login-only endpoints (--sections auth).
# DevTools -> Application -> Cookies -> higgsfield.ai -> __session. Expires in ~60 s; refresh right before a run.
HF_TOKEN=

# Defaults for CLI flags
HF_LOCALE=en
HF_RUNS_DIR=runs
HF_LOG_LEVEL=INFO

# Set to 1 to run the live API tests in pytest
HF_LIVE=0
