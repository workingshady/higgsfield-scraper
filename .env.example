# Copy to .env (gitignored). Every value is optional. Never commit .env.

# ---------------------------------------------------------------------------------------------------------------
# Login (only needed for login-only data: top-ups, unlimited bundles, credit price, soul styles, per-model motion
# lists, mixed-media presets, comments, your own account data). Public scraping needs nothing.
#
# Option A (recommended) — email + password, one-time emailed code, then fully automatic:
#   1) fill HF_EMAIL / HF_PASSWORD below
#   2) python -m higgsfield_scraper login              -> Clerk emails a 6-digit code to the account
#   3) python -m higgsfield_scraper login --code 123456 -> session cached in runs/.auth/clerk_client.json (gitignored)
#   4) python -m higgsfield_scraper auth-check          -> should print "ok": true
#   From then on every run mints fresh ~60 s session tokens automatically (no password, no code) for as long as the
#   Clerk session lives (cookie valid up to 400 days). If it ever expires, repeat steps 2–3.
#   Note: accounts that sign in with Google/Apple have no Higgsfield password — use option B.
HF_EMAIL=
HF_PASSWORD=
#
# Option B — paste the long-lived Clerk cookie from your browser (no password stored):
#   Log in at higgsfield.ai in Chrome -> DevTools -> Application -> Cookies -> https://higgsfield.ai
#   -> copy the value of `__client` (path /_clerk) here.
HF_CLERK_CLIENT=
#
# Option C — a one-off session JWT (the `__session` cookie); expires after ~60 s, no refresh:
HF_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# Defaults for CLI flags
HF_LOCALE=en
HF_RUNS_DIR=runs
HF_LOG_LEVEL=INFO

# Set to 1 to run the live API tests in pytest
HF_LIVE=0
