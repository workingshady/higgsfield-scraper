                                "v2",
                                "plan-benefits"
                            ],
                            "query": [
                                {
                                    "key": "locale",
                                    "value": "{{locale}}"
                                }
                            ]
                        },
                        "description": "Card sections; job_set_types join to /job-sets/costs.",
                        "auth": {
                            "type": "noauth"
                        }
