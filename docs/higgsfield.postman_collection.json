                {
                    "name": "Plan sets enum (expects 422)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Origin",
                                "value": "https://higgsfield.ai"
                            },
                            {
                                "key": "Referer",
                                "value": "https://higgsfield.ai/pricing"
                            }
                        ],
                        "url": {
                            "raw": "{{api_base}}/subscriptions/v2/plans?plan_set_key=__list__",
                            "host": [
                                "{{api_base}}"
                            ],
                            "path": [
                                "subscriptions",
                                "v2",
                                "plans"
                            ],
                            "query": [
                                {
                                    "key": "plan_set_key",
                                    "value": "__list__"
                                }
                            ]
                        },
                        "description": "Returns 422 whose message lists every valid plan_set_key.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('422 lists plan sets', () => pm.response.to.have.status(422));",
                                    "console.log(pm.response.json().detail[0].msg);"
                                ]
                            }
                        }
                    ]
                }
